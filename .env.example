# AegisSovereign - environment template (all 9 planes).
# Copy to .env and adjust. Every key maps 1:1 to SecurityConfig.from_environment().

# --- General ---
SECRET_KEY=change-me-in-production--generate-with-secrets-token_urlsafe-48
DATABASE_URL=sqlite:///./instance/aegis_sovereign.db
REDIS_URL=redis://localhost:6379/3
CORS_ORIGINS=*

# --- Failure policy / latency ---
FAIL_OPEN_THRESHOLD=0.02
FAIL_OPEN_FOR_VERIFIED=0
EDGE_RULE_LATENCY_P99_MS=5
SYNC_DECISION_LATENCY_P99_MS=30

# --- P1 Network ---
GEO_DB_PATH=./data/GeoLite2-Country.mmdb
ASN_DB_PATH=./data/GeoLite2-ASN.mmdb
ENABLE_PASSIVE_OS_FINGERPRINT=1
ENABLE_RTT_CONSISTENCY=1
ENABLE_SHARED_EGRESS_DETECTION=1
MAX_SUBNET_TAIL=64
REPUTATION_FEED_URLS=https://threatfeed.example.net/feeds/current.json

# --- P2 Transport ---
ENABLE_JA4_TLS=1
ENABLE_JA4_S=0
ENABLE_JA4_H=1
ENABLE_JA4_T=0
ENABLE_JA4_L=0
ENABLE_QUIC_FINGERPRINT=1
ENABLE_HYBRID_PQ=1
CLIENT_HINT_COHERENCE=1

# --- P3 Client integrity ---
SIGNED_CHALLENGE_TTL=5
SIGNED_CHALLENGE_BUFFER=15
CHALLENGE_ROTATION_HOURS=6
COHERENCE_FONTS=1
COHERENCE_TZ=1
COHERENCE_LANG=1
COHERENCE_SCREEN=1
COHERENCE_CODECS=1
COHERENCE_GPU=1
RARITY_WINDOW_DAYS=30
ENABLE_GPU_SW=1

# --- P4 Behaviour ---
BEHAVIOUR_ENABLED=0
BEHAVIOUR_SEQ=0

# --- P5 Identity ---
ENABLE_PASSKEYS=1
ENABLE_BREACH=1
ENABLE_DPOP=0
ENABLE_SESSION_BIND=1
RECOVERY_COOL_HOURS=24
STEP_UP_ACTIONS=payout_destination_change,withdrawal,recovery,new_device,credential_change

# --- P6 Biometric ---
BIOMETRIC_ENABLED=0
BIOMETRIC_LEVEL=IAL2/AAL2

# --- P7 Decision ---
ENABLE_ENSEMBLE=1
ENABLE_HARD_GATES=1
SHADOW_MODE=1

# --- P8 Response ---
ADAPTIVE_POW=1
POW_FLOOR=20
POW_SCALE=1.5
PRIVACY_PASS=0
STEPUP_HUMAN_PROOF=1
TARPIT_ASYNC=1
DECEPTION_THRESHOLD=0.85
BLOCK_HARD_GATES_ONLY=1

# --- Rate limits / P9 / privacy ---
RL_API_CREATE=60
RL_LOGIN=10
RL_RECOVERY=3
RL_PAYOUT=2
RL_CHALLENGE=300
SHADOW_RATIO=0.25
PSI_THRESHOLD=0.1
RED_TEAM_DAYS=90
HONEYPOT=1
DATA_MIN=1
BIO_CONSENT=0
RAW_RETENTION_H=24
FEAT_RETENTION_D=90

# --- Runtime resilience / bounded state ---
PLANE_TIMEOUT_MS=0.75
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=5
REPLAY_CACHE_ENTRIES=100000
MAINTENANCE_INTERVAL_SECONDS=30
TELEMETRY_MAX_EVENTS=50000
POW_MIN_DIFFICULTY=14
POW_MAX_DIFFICULTY=28
